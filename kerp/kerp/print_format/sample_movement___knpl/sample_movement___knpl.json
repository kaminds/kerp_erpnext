 "html": "<div style=\"font-family: Arial, Helvetica, sans-serif; font-size: 14px; line-height: 1.5;\">\n\n    <!-- TO SECTION -->\n    <div style=\"margin-bottom: 23px; line-height: 1.4;\">\n        <div>To</div>\n        <div>{{ doc.contact_person }}</div>\n        <div style=\"font-weight: 700;\">{{ doc.party_name }}</div>\n        <div>\n            {{ doc.party_address }}\n        </div>\n        <div>\n            Mobile: {{ doc.contact_person_mobile }}\n        </div>\n    </div>\n\n    <!-- FROM SECTION -->\n    <div style=\"margin-top: 10px; font-size: 12px;\">\n        <div>From:</div>\n\n        <div>\n            <div style=\"margin-right: 12px;\">\n                <!-- Company Logo -->\n                    <img src=\"data:image/png;base64,\"\n                    style=\"max-height: 60px;\">\n            </div>\n            <div>\n                <div style=\"font-weight: bold; font-size: 12px;\">\n                    {{ doc.company or \"Kaminds Nutrichem Private Limited\" }}\n                </div>\n                <div>\n                    J-1235-1236, Phase-III, Sitapura Industrial Area,<br>\n                    Sitapura, Jaipur, Rajasthan - 302022\n                </div>\n                <div>\n                    Email: contact@kaminds.com\n                </div>\n            </div>\n        </div>\n    </div>\n\n</div>\n\n<div style=\"font-family: Arial, Helvetica, sans-serif; font-size: 12px;\">\n\n\n{% for row in doc.items %}\n\n<table style=\"width: 60%; border-collapse: collapse; margin-top: 20px; border: 2px solid #000; page-break-inside: avoid;\">\n\n    <!-- HEADER -->\n    <tr>\n        <td style=\"width: 30%; text-align: center; vertical-align: middle; padding-top: 7px !important; border: 1px solid #000;\">\n            {% if frappe.db.get_value(\"Company\", doc.company, \"company_logo\") %}\n                <img src=\"{{ frappe.db.get_value('Company', doc.company, 'company_logo') }}\"\n                     style=\"max-height: 65px; width: auto !important;\"><br>\n            {% endif %}\n        </td>\n\n        <td style=\"width: 70%; text-align: center; padding: 5px; border: 1px solid #000;\">\n            <div style=\"font-size: 13px; font-weight: bold; line-height: 1.3;\">\n                Kaminds Nutrichem Private Limited\n            </div>\n            <div style=\"font-size: 12px; margin-top: 3px; line-height: 1.4;\">\n                J-1235-1236, Phase-III, Sitapura Industrial Area,<br>\n                Sitapura, Jaipur - 302022, Rajasthan<br>\n                Email: contact@kaminds.com\n            </div>\n        </td>\n    </tr>\n\n    <!-- PRODUCT -->\n    <tr>\n        <td style=\"padding: 1px !important; padding-left: 3px !important; font-weight: bold; border: 1px solid #000;\">Product Name</td>\n        <td style=\"padding: 1px !important; padding-left: 3px !important; border: 1px solid #000;\">{{ row.item_name }}</td>\n    </tr>\n    {% set batch = frappe.db.get_value(\"Batch\", row.batch_no, [\"batch_no_kerp\", \"manufacturing_date\", \"expiry_date\"], as_dict=True) %}\n    <!-- BATCH -->\n    <tr>\n        <td style=\"padding: 1px !important; padding-left: 3px !important; font-weight: bold; border: 1px solid #000;\">Batch No.</td>\n        <td style=\"padding: 1px !important; padding-left: 3px !important; border: 1px solid #000;\">{{ batch.batch_no_kerp or \"\" }}</td>\n    </tr>\n\n    <!-- QUANTITY -->\n    <tr>\n        <td style=\"padding: 1px !important; padding-left: 3px !important; font-weight: bold; border: 1px solid #000;\">Quantity</td>\n        <td style=\"padding: 1px !important; padding-left: 3px !important; border: 1px solid #000;\">{{abs(row.qty) | int if row.qty == row.qty|int else abs(row.qty)}} {{row.uom}}(s)</td>\n    </tr>\n\n    <!-- MFG DATE -->\n    <tr>\n        <td style=\"padding: 1px !important; padding-left: 3px !important; font-weight: bold; border: 1px solid #000;\">Mfg Date</td>\n        <td style=\"padding: 1px !important; padding-left: 3px !important; border: 1px solid #000;\">\n            {{ frappe.utils.formatdate(batch.manufacturing_date, \"MMMM yyyy\") if batch.manufacturing_date else \"\" }}\n        </td>\n    </tr>\n\n    <!-- EXPIRY -->\n    <tr>\n        <td style=\"padding: 1px !important; padding-left: 3px !important; font-weight: bold; border: 1px solid #000;\">Expiry Date</td>\n        <td style=\"padding: 1px !important; padding-left: 3px !important; border: 1px solid #000;\">\n            {% if batch.expiry_date %}\n                {{ frappe.utils.formatdate(batch.expiry_date, \"MMMM yyyy\") }}\n            {% else %}\n                {{\"\"}}\n            {% endif %}\n        </td>\n    </tr>\n\n    <!-- DISTRIBUTED BY -->\n    <tr>\n        <td style=\"padding: 1px !important; padding-left: 3px !important; font-weight: bold; border: 1px solid #000;\">Distributed By</td>\n        <td style=\"padding: 1px !important; padding-left: 3px !important; border: 1px solid #000;\">{{ doc.company }}</td>\n    </tr>\n\n    <!-- FOOTER -->\n    <tr>\n        <td colspan=\"2\" style=\"text-align: center; padding: 4px !important; font-size: 14px; font-weight: bold; border: 1px solid #000; border-top: 2px solid #000; line-height: 1;\">\n            FREE SAMPLE\n        </td>\n    </tr>\n\n</table>\n\n{% endfor %}\n\n</div>",
